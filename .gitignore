# Git Ignore

# CafeKit / Ecosystem
specs/_shared/
plans/*
!plans/*.md
!plans/templates/
!plans/templates/**
.cafekit-backup/
.cafekit.lock
.claude/
.codex/
.omp/
.agents/

# .NET build output
bin/
obj/
*.user
TestResults/

# Secrets: TLS certificates/keys must never be committed
deployments/**/certs/
deployments/.secrets/

# Edge buffer when run from Visual Studio / dotnet run (Buffer:Path is relative to src/Edge)
src/Edge/data/
