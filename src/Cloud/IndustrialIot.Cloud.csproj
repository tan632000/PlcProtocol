<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Pinned so consumers (the tests) compile against the same EF Core as the Design package brings in. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cloud.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SCADA page, served from the assembly by ScadaEndpoints (never from the file system). -->
    <EmbeddedResource Include="Scada\index.html" LogicalName="IndustrialIot.Cloud.Scada.index.html" />
    <EmbeddedResource Include="Scada\app.js" LogicalName="IndustrialIot.Cloud.Scada.app.js" />
    <EmbeddedResource Include="Scada\scada-core.js" LogicalName="IndustrialIot.Cloud.Scada.scada-core.js" />
    <EmbeddedResource Include="Scada\signalr.min.js" LogicalName="IndustrialIot.Cloud.Scada.signalr.min.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\IndustrialIot.Shared.csproj" />
  </ItemGroup>

</Project>
