{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cloud": {
    "Edges": [
      { "EdgeId": "line1-edge01", "DisplayName": "Line 1" }
    ],
    "Commands": {
      "Enabled": false,
      "DefaultTtlSeconds": 60,
      "MaxTtlSeconds": 600,
      "TimeoutGraceSeconds": 120
    },
    "Retention": {
      "TelemetryDays": 90
    },
    "Auth": {
      "Authority": "",
      "Audience": "",
      "RoleClaimType": "roles",
      "ViewerRole": "Viewer",
      "OperatorRole": "Operator",
      "ClockSkewSeconds": 30
    },
    "Mqtt": {
      "Host": "",
      "Port": 8883,
      "Username": "iiot-cloud",
      "CaCertificatePath": "",
      "ClientId": "iiot-cloud",
      "KeepAliveSeconds": 30,
      "ReconnectMinDelayMs": 1000,
      "ReconnectMaxDelayMs": 30000
    },
    "Health": {
      "RefreshSeconds": 15
    },
    "ForwardedHeaders": {
      "KnownProxies": []
    },
    "Scada": {
      "Enabled": true,
      "ClientId": "iiot-scada"
    }
  }
}
