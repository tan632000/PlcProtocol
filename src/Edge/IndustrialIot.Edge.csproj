<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <!-- Development only: the host loads `dotnet user-secrets` (outside the repo), e.g. the local broker password. -->
    <UserSecretsId>iiot-edge-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    <PackageReference Include="S7netplus" Version="0.20.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel for the local monitor page (Monitoring/MonitorServer.cs). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Monitoring\monitor.html" LogicalName="IndustrialIot.Edge.Monitoring.monitor.html" />
    <EmbeddedResource Include="Monitoring\settings.html" LogicalName="IndustrialIot.Edge.Monitoring.settings.html" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lab settings for live PLC checks (VS profile "FX5U test"); never shipped to customers. -->
    <Content Update="lab\**" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <!-- Dev buffer, settings and settings-password files written at run time; never shipped. -->
    <Content Update="data\**" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Edge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\IndustrialIot.Shared.csproj" />
  </ItemGroup>

</Project>
