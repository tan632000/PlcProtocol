{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Edge": {
    "EdgeId": "line1-edge01",
    "Plc": {
      "Host": "192.168.0.10",
      "Port": 102,
      "Rack": 0,
      "Slot": 1,
      "TimeoutMs": 3000
    },
    "Tags": [
      { "TagId": "Line1.Speed", "Address": "DB1.DBW2", "DataType": "Int", "Writable": false }
    ],
    "Poll": {
      "IntervalMs": 1000
    },
    "Mqtt": {
      "Host": "mqtt.example.local",
      "Port": 8883,
      "Username": "line1-edge01",
      "KeepAliveSeconds": 30,
      "ReconnectMinDelayMs": 1000,
      "ReconnectMaxDelayMs": 30000,
      "PublishBatchSize": 100
    },
    "Buffer": {
      "Path": "data/edge.db",
      "MaxAgeHours": 168,
      "MaxRows": 1000000
    }
  }
}
