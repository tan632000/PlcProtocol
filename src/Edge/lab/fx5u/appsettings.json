    "Plc": { "Protocol": "Slmp", "Host": "192.168.3.250", "Port": 5000, "TimeoutMs": 3000 },
    "Tags": [
      { "TagId": "Lab.IntD", "Address": "D100", "DataType": "Int", "Writable": false },
      { "TagId": "Lab.DIntD", "Address": "D102", "DataType": "DInt", "Writable": false },
      { "TagId": "Lab.RealD", "Address": "D104", "DataType": "Real", "Writable": false },
      { "TagId": "Lab.M14", "Address": "M14", "DataType": "Bool", "Writable": false },
      { "TagId": "Lab.M15", "Address": "M15", "DataType": "Bool", "Writable": false },
      { "TagId": "Lab.M101", "Address": "M101", "DataType": "Bool", "Writable": false },
      { "TagId": "Lab.X10", "Address": "X10", "DataType": "Bool", "Writable": false },
      { "TagId": "Lab.X12", "Address": "X12", "DataType": "Bool", "Writable": false },
      { "TagId": "Lab.Y10", "Address": "Y10", "DataType": "Bool", "Writable": false },
      { "TagId": "Lab.Y12", "Address": "Y12", "DataType": "Bool", "Writable": false }
