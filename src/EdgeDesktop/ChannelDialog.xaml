<Window x:Class="IndustrialIot.EdgeDesktop.ChannelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12" FocusManager.FocusedElement="{Binding ElementName=NameBox}">
  <!-- Add or edit a channel (plan D-05). The driver is picked in DriverDialog, only while the channel has no PLC. -->
  <Window.Resources>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Width" Value="100" />
      <Setter Property="Margin" Value="0,3,8,0" />
    </Style>
    <Style x:Key="Error" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#C62828" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <StackPanel Margin="14" Width="380">
    <DockPanel Margin="0,0,0,8">
      <TextBlock Style="{StaticResource Label}" Text="Tên channel:" />
      <StackPanel>
        <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource Error}" Text="{Binding FieldErrors[Name]}" />
      </StackPanel>
    </DockPanel>

    <DockPanel Margin="0,0,0,8">
      <TextBlock Style="{StaticResource Label}" Text="Driver:" />
      <Button DockPanel.Dock="Right" Content="…" Width="28" Margin="4,0,0,0" Click="OnDriver"
              IsEnabled="{Binding CanChangeDriver}" ToolTipService.ShowOnDisabled="True"
              ToolTip="Chọn driver (chỉ đổi được khi channel chưa có PLC)" />
      <TextBox IsReadOnly="True" Text="{Binding DriverDisplay, Mode=OneWay}" />
    </DockPanel>

    <TextBlock Text="{Binding DriverNote}" Foreground="#667085" TextWrapping="Wrap" Margin="108,0,0,0" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="OK" Width="80" IsDefault="True" Click="OnOk" />
      <Button Content="Huỷ" Width="80" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
