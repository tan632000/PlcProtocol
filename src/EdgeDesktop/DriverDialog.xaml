<Window x:Class="IndustrialIot.EdgeDesktop.DriverDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:IndustrialIot.EdgeDesktop.Core;assembly=IndustrialIot.EdgeDesktop.Core"
        Title="Chọn driver" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12" FocusManager.FocusedElement="{Binding ElementName=DriverBox}">
  <!-- The driver of a channel with the PLC models it supports, from the Edge's catalog (plan D-05). -->
  <StackPanel Margin="14" Width="340">
    <TextBlock Text="Driver:" Margin="0,0,0,4" />
    <ComboBox x:Name="DriverBox" ItemsSource="{x:Static core:ChannelDialogViewModel.Drivers}"
              DisplayMemberPath="Display" SelectedValuePath="Driver" SelectionChanged="OnPick" />
    <TextBlock Text="{Binding DriverNote}" Foreground="#667085" TextWrapping="Wrap" Margin="0,8,0,0" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="OK" Width="80" IsDefault="True" Click="OnOk" />
      <Button Content="Huỷ" Width="80" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
