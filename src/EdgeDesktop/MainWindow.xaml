<Window x:Class="IndustrialIot.EdgeDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:core="clr-namespace:IndustrialIot.EdgeDesktop.Core;assembly=IndustrialIot.EdgeDesktop.Core"
        xmlns:local="clr-namespace:IndustrialIot.EdgeDesktop"
        mc:Ignorable="d"
        Title="{Binding Title}" Width="1200" Height="780" MinWidth="720" MinHeight="480"
        FontFamily="Segoe UI" FontSize="12" KeyDown="OnWindowKey">
  <!-- A classic driver-tool window (plan D-03): menu, toolbar, tree Channel → PLC, tag grid, event log, status bar. -->
  <Window.Resources>
    <!-- A state text whose colour follows its Tag, a BadgeKind. -->
    <Style x:Key="Badge" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#667085" />
      <Style.Triggers>
        <Trigger Property="Tag" Value="{x:Static core:BadgeKind.Ok}">
          <Setter Property="Foreground" Value="#1A7F37" />
        </Trigger>
        <Trigger Property="Tag" Value="{x:Static core:BadgeKind.Warn}">
          <Setter Property="Foreground" Value="#9A6700" />
        </Trigger>
        <Trigger Property="Tag" Value="{x:Static core:BadgeKind.Bad}">
          <Setter Property="Foreground" Value="#C62828" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="Vertical" />
      <Setter Property="VerticalGridLinesBrush" Value="#E4E7EC" />
      <Setter Property="RowHeaderWidth" Value="0" />
    </Style>
    <Style TargetType="Button" x:Key="Tool">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>
  </Window.Resources>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_Tệp">
        <MenuItem Header="_Lưu &amp; áp dụng" Command="{x:Static local:MainWindow.SaveCommand}" />
        <MenuItem Header="_Tải lại từ Edge" Command="{x:Static local:MainWindow.ReloadCommand}" />
        <Separator />
        <MenuItem Header="_Thoát" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Sửa">
        <MenuItem Header="Thêm _Channel" Command="{x:Static local:MainWindow.AddChannelCommand}" />
        <MenuItem Header="Thêm _PLC" Command="{x:Static local:MainWindow.AddDeviceCommand}" />
        <MenuItem Header="Thêm T_ag" Command="{x:Static local:MainWindow.AddTagCommand}" />
        <Separator />
        <MenuItem Header="_Sửa…" InputGestureText="Enter" Command="{x:Static local:MainWindow.EditCommand}" />
        <MenuItem Header="_Xoá" Command="{x:Static local:MainWindow.DeleteCommand}" />
      </MenuItem>
      <MenuItem Header="_Xem">
        <MenuItem x:Name="LogMenu" Header="_Log sự kiện" IsCheckable="True" IsChecked="True"
                  Checked="OnLogShown" Unchecked="OnLogShown" />
      </MenuItem>
      <MenuItem Header="_Công cụ">
        <MenuItem Header="_Kiểm tra cấu hình" Command="{x:Static local:MainWindow.CheckCommand}" />
        <MenuItem Header="_Test kết nối PLC" Command="{x:Static local:MainWindow.TestConnectionCommand}" />
        <Separator />
        <MenuItem Header="_Mở trang cấu hình web" Click="OpenSettings" />
      </MenuItem>
      <MenuItem Header="_Trợ giúp">
        <MenuItem Header="_Giới thiệu" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
      <ToolBar>
        <Button Style="{StaticResource Tool}" Content="Lưu" ToolTip="Lưu &amp; áp dụng (Ctrl+S)" Command="{x:Static local:MainWindow.SaveCommand}" />
        <Separator />
        <Button Style="{StaticResource Tool}" Content="Thêm Channel" ToolTip="Thêm Channel" Command="{x:Static local:MainWindow.AddChannelCommand}" />
        <Button Style="{StaticResource Tool}" Content="Thêm PLC" ToolTip="Thêm PLC vào channel đang chọn" Command="{x:Static local:MainWindow.AddDeviceCommand}" />
        <Button Style="{StaticResource Tool}" Content="Thêm Tag" ToolTip="Thêm tag vào PLC đang chọn" Command="{x:Static local:MainWindow.AddTagCommand}" />
        <Separator />
        <Button Style="{StaticResource Tool}" Content="Sửa" ToolTip="Sửa mục đang chọn (Enter)" Command="{x:Static local:MainWindow.EditCommand}" />
        <Button Style="{StaticResource Tool}" Content="Xoá" ToolTip="Xoá mục đang chọn (Del)" Command="{x:Static local:MainWindow.DeleteCommand}" />
        <Separator />
        <Button Style="{StaticResource Tool}" Content="Kiểm tra" ToolTip="Kiểm tra cấu hình trên Edge" Command="{x:Static local:MainWindow.CheckCommand}" />
      </ToolBar>
    </ToolBarTray>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock Text="{Binding EdgeField}">
          <TextBlock.Style>
            <Style TargetType="TextBlock" d:DataContext="{d:DesignInstance core:MainViewModel}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding EdgeFieldIsError}" Value="True">
                  <Setter Property="Foreground" Value="#C62828" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StatusBarItem>
      <Separator />
      <StatusBarItem Content="{Binding Endpoint}" />
      <Separator />
      <StatusBarItem Content="{Binding MqttField}" />
      <Separator />
      <StatusBarItem Content="{Binding BufferField}" />
      <Separator />
      <StatusBarItem Content="{Binding CycleField}" />
      <Separator />
      <StatusBarItem Content="{Binding CommandsField}" />
      <Separator />
      <StatusBarItem Content="{Binding SaveField}" />
    </StatusBar>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="120" />
        <RowDefinition x:Name="LogSplitterRow" Height="5" />
        <RowDefinition x:Name="LogRow" Height="180" />
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300" MinWidth="160" />
          <ColumnDefinition Width="5" />
          <ColumnDefinition Width="*" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <TreeView x:Name="Tree" ItemsSource="{Binding Tree}" BorderThickness="0,0,1,0"
                  SelectedItemChanged="OnTreeSelected" MouseDoubleClick="OnTreeDoubleClick" KeyDown="OnTreeKey"
                  GotKeyboardFocus="OnTreeFocused">
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem" d:DataContext="{d:DesignInstance core:TreeNode}">
              <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>
          </TreeView.ItemContainerStyle>
          <TreeView.ItemTemplate>
            <HierarchicalDataTemplate d:DataContext="{d:DesignInstance core:TreeNode}" ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock Text="{Binding Text}" />
                <TextBlock Text="{Binding State}" Tag="{Binding StateKind}" Style="{StaticResource Badge}" Margin="10,0,0,0" />
              </StackPanel>
            </HierarchicalDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

        <Grid Grid.Column="2">
          <DataGrid x:Name="TagGrid" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
                    BorderThickness="0" MouseDoubleClick="OnGridDoubleClick" PreviewKeyDown="OnGridKey">
            <!-- Before the grid's own Delete binding, which a read-only grid marks handled and so swallows Del. -->
            <DataGrid.InputBindings>
              <KeyBinding Key="Delete" Command="{x:Static local:MainWindow.DeleteCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
              <DataGridTextColumn d:DataContext="{d:DesignInstance core:GridRow}" Header="Tag Name" Binding="{Binding Name}" Width="140" />
              <DataGridTextColumn d:DataContext="{d:DesignInstance core:GridRow}" Header="Address" Binding="{Binding Address}" Width="110" />
              <DataGridTextColumn d:DataContext="{d:DesignInstance core:GridRow}" Header="Data Type" Binding="{Binding DataType}" Width="80" />
              <DataGridTextColumn d:DataContext="{d:DesignInstance core:GridRow}" Header="Client Access" Binding="{Binding Access}" Width="90" />
              <DataGridTextColumn d:DataContext="{d:DesignInstance core:GridRow}" Header="Value" Binding="{Binding Value}" Width="100" />
              <DataGridTemplateColumn d:DataContext="{d:DesignInstance core:GridRow}" Header="Chất lượng" Width="80">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate d:DataContext="{d:DesignInstance core:GridRow}">
                    <TextBlock Text="{Binding Quality}" Tag="{Binding QualityKind}" Style="{StaticResource Badge}" Margin="2,0" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn d:DataContext="{d:DesignInstance core:GridRow}" Header="Thời điểm đọc" Binding="{Binding Time}" Width="90" />
              <DataGridTextColumn d:DataContext="{d:DesignInstance core:GridRow}" Header="Lỗi" Binding="{Binding Error}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="{Binding GridPlaceholder}" Foreground="#667085" HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsHitTestVisible="False" />
        </Grid>
      </Grid>

      <GridSplitter x:Name="LogSplitter" Grid.Row="1" HorizontalAlignment="Stretch" />

      <DataGrid x:Name="LogGrid" Grid.Row="2" ItemsSource="{Binding Log}" BorderThickness="0,1,0,0">
        <DataGrid.Columns>
          <DataGridTextColumn d:DataContext="{d:DesignInstance core:LogEntry}" Header="Thời gian" Binding="{Binding Time}" Width="70" />
          <DataGridTextColumn d:DataContext="{d:DesignInstance core:LogEntry}" Header="Nguồn" Binding="{Binding Source}" Width="120" />
          <DataGridTextColumn d:DataContext="{d:DesignInstance core:LogEntry}" Header="Sự kiện" Binding="{Binding Message}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </DockPanel>
</Window>
