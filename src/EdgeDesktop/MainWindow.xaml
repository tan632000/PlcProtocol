<Window x:Class="IndustrialIot.EdgeDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:IndustrialIot.EdgeDesktop.Core;assembly=IndustrialIot.EdgeDesktop.Core"
        Width="1200" Height="800" MinWidth="640" MinHeight="480"
        Background="#F4F5F7" Foreground="#1D2330" FontFamily="Segoe UI" FontSize="13">
  <!-- Same content, words and colours as the web monitor (src/Edge/Monitoring/monitor.html). Read-only. -->
  <Window.Style>
    <Style TargetType="Window">
      <Setter Property="Title" Value="{Binding EdgeId, StringFormat='IIoT Edge Monitor — {0}'}" />
      <Style.Triggers>
        <!-- No status yet: no dangling dash. -->
        <DataTrigger Binding="{Binding EdgeId}" Value="">
          <Setter Property="Title" Value="IIoT Edge Monitor" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Style>
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#DFE3EA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#667085" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="Detail" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#667085" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- A pill whose colours follow its Tag, a BadgeKind. -->
    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="#EEF0F3" />
      <Setter Property="TextElement.Foreground" Value="#475467" />
      <Setter Property="TextElement.FontWeight" Value="SemiBold" />
      <Style.Triggers>
        <Trigger Property="Tag" Value="{x:Static core:BadgeKind.Ok}">
          <Setter Property="Background" Value="#E6F4EA" />
          <Setter Property="TextElement.Foreground" Value="#1A7F37" />
        </Trigger>
        <Trigger Property="Tag" Value="{x:Static core:BadgeKind.Warn}">
          <Setter Property="Background" Value="#FFF4D6" />
          <Setter Property="TextElement.Foreground" Value="#9A6700" />
        </Trigger>
        <Trigger Property="Tag" Value="{x:Static core:BadgeKind.Bad}">
          <Setter Property="Background" Value="#FDECEA" />
          <Setter Property="TextElement.Foreground" Value="#C62828" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#DFE3EA" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#DFE3EA" />
      <Setter Property="RowHeaderWidth" Value="0" />
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas" />
    </Style>
    <Style x:Key="Error" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#C62828" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="16">
    <!-- Header -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Content="Mở trang cấu hình" Padding="12,4" Click="OpenSettings" />
      <TextBlock DockPanel.Dock="Right" Text="{Binding Updated}" Foreground="#667085" VerticalAlignment="Center" Margin="0,0,12,0" />
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="PLC Monitor" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Foreground="#667085" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Bottom">
          <Run Text="Edge ID:" /> <Run Text="{Binding EdgeId, Mode=OneWay}" FontWeight="SemiBold" />
        </TextBlock>
      </StackPanel>
    </DockPanel>

    <!-- Banner: shown while the last poll failed -->
    <Border DockPanel.Dock="Top" Background="#FDECEA" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
      <Border.Style>
        <Style TargetType="Border">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Banner}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock Text="{Binding Banner}" Foreground="#C62828" TextWrapping="Wrap" />
    </Border>

    <TextBlock DockPanel.Dock="Bottom" Margin="0,12,0,0" FontSize="12" Foreground="#667085"
               Text="Chỉ xem — ứng dụng này không ghi xuống PLC và không đổi cấu hình. Tự cập nhật khoảng mỗi giây; giá trị là kết quả chu kỳ đọc gần nhất của Edge." />

    <!-- Cards -->
    <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,-12,12">
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="PLC" Style="{StaticResource CardTitle}" />
          <Border Style="{StaticResource Badge}" Tag="{Binding PlcKind}">
            <TextBlock Text="{Binding PlcText}" />
          </Border>
          <TextBlock Text="{Binding PlcDetail}" Style="{StaticResource Detail}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Chu kỳ đọc gần nhất" Style="{StaticResource CardTitle}" />
          <TextBlock Text="{Binding LastCycle}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding PollDetail}" Style="{StaticResource Detail}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="MQTT (gửi lên Cloud)" Style="{StaticResource CardTitle}" />
          <Border Style="{StaticResource Badge}" Tag="{Binding MqttKind}">
            <TextBlock Text="{Binding MqttText}" />
          </Border>
          <TextBlock Text="{Binding MqttDetail}" Style="{StaticResource Detail}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Buffer chờ gửi" Style="{StaticResource CardTitle}" />
          <TextBlock Text="{Binding Pending}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Số mẫu đang lưu trên máy, chưa gửi được lên Cloud" Style="{StaticResource Detail}" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- MaxHeight on the grid itself, not the Auto row: an Auto row measures with infinite height, so the grid
           would never show a scroll bar and PLCs past the limit would be cut off. -->
      <DataGrid Grid.Row="0" MaxHeight="240" ItemsSource="{Binding Devices}" Margin="0,0,0,12">
        <DataGrid.Columns>
          <DataGridTextColumn Header="PLC" Binding="{Binding Name}" />
          <DataGridTextColumn Header="Model" Binding="{Binding Model}" />
          <DataGridTextColumn Header="Địa chỉ" Binding="{Binding Address}" ElementStyle="{StaticResource Mono}" />
          <DataGridTemplateColumn Header="Trạng thái">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Badge}" Tag="{Binding StateKind}">
                  <TextBlock Text="{Binding State}" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Đọc tốt gần nhất" Binding="{Binding LastGood}" ElementStyle="{StaticResource Mono}" />
          <DataGridTextColumn Header="Thời gian đọc" Binding="{Binding ReadTime}" ElementStyle="{StaticResource Mono}" />
          <DataGridTextColumn Header="Số request" Binding="{Binding Requests}" ElementStyle="{StaticResource Mono}" />
          <DataGridTextColumn Header="Lỗi" Binding="{Binding Error}" ElementStyle="{StaticResource Error}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>

      <DataGrid Grid.Row="1" ItemsSource="{Binding Tags}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Tag" Binding="{Binding TagId}" />
          <DataGridTextColumn Header="PLC" Binding="{Binding Device}" />
          <DataGridTextColumn Header="Địa chỉ" Binding="{Binding Address}" ElementStyle="{StaticResource Mono}" />
          <DataGridTextColumn Header="Kiểu" Binding="{Binding DataType}" />
          <DataGridTextColumn Header="Giá trị" Binding="{Binding Value}" FontWeight="SemiBold" />
          <DataGridTemplateColumn Header="Chất lượng">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Badge}" Tag="{Binding QualityKind}">
                  <TextBlock Text="{Binding Quality}" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Thời điểm đọc" Binding="{Binding Time}" ElementStyle="{StaticResource Mono}" />
          <DataGridTextColumn Header="Ghi" Binding="{Binding Access}" />
          <DataGridTextColumn Header="Lỗi" Binding="{Binding Error}" ElementStyle="{StaticResource Error}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </DockPanel>
</Window>
