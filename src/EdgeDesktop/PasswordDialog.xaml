<Window x:Class="IndustrialIot.EdgeDesktop.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mật khẩu settings" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12" FocusManager.FocusedElement="{Binding ElementName=Box}">
  <!-- Plan D-06: no binding to the password; the box is read once into the one request and cleared. -->
  <StackPanel Margin="14" Width="320">
    <TextBlock x:Name="Purpose" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Text="Mật khẩu settings của Edge:" Margin="0,8,0,4" />
    <PasswordBox x:Name="Box" PasswordChanged="OnChanged" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="OkButton" Content="OK" Width="80" IsDefault="True" IsEnabled="False" Click="OnOk" />
      <Button Content="Huỷ" Width="80" Margin="8,0,0,0" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
