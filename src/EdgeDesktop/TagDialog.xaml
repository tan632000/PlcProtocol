<Window x:Class="IndustrialIot.EdgeDesktop.TagDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12" FocusManager.FocusedElement="{Binding ElementName=NameBox}">
  <!-- Add or edit a tag (plan D-05). Áp dụng in Add mode keeps the dialog open for the next tag. -->
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Width" Value="110" />
      <Setter Property="Margin" Value="0,3,8,0" />
    </Style>
    <Style x:Key="Field" TargetType="DockPanel">
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Error" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#C62828" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <StackPanel Margin="14" Width="420">
    <DockPanel Style="{StaticResource Field}">
      <TextBlock Style="{StaticResource Label}" Text="Tên tag:" />
      <StackPanel>
        <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource Error}" Text="{Binding FieldErrors[Name]}" />
      </StackPanel>
    </DockPanel>

    <DockPanel Style="{StaticResource Field}">
      <TextBlock Style="{StaticResource Label}" Text="Địa chỉ:" />
      <StackPanel>
        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource Error}" Text="{Binding FieldErrors[Address]}" />
      </StackPanel>
    </DockPanel>

    <DockPanel Style="{StaticResource Field}">
      <TextBlock Style="{StaticResource Label}" Text="Kiểu dữ liệu:" />
      <StackPanel>
        <ComboBox ItemsSource="{Binding DataTypes}" SelectedItem="{Binding DataType}" />
        <TextBlock Style="{StaticResource Error}" Text="{Binding FieldErrors[DataType]}" />
      </StackPanel>
    </DockPanel>

    <DockPanel Style="{StaticResource Field}" Visibility="{Binding IsString, Converter={StaticResource Visible}}">
      <TextBlock Style="{StaticResource Label}" Text="Độ dài:" />
      <StackPanel>
        <TextBox Text="{Binding LengthText, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource Error}" Text="{Binding FieldErrors[Length]}" />
      </StackPanel>
    </DockPanel>

    <StackPanel Margin="118,0,0,8">
      <CheckBox Content="Ghi" IsChecked="{Binding Writable}" IsEnabled="{Binding CanWrite}"
                ToolTipService.ShowOnDisabled="True" ToolTip="Chỉ bật được khi dòng PLC cho phép ghi" />
      <TextBlock Style="{StaticResource Error}" Text="{Binding FieldErrors[Writable]}" />
    </StackPanel>

    <DockPanel Style="{StaticResource Field}" Visibility="{Binding ShowLimits, Converter={StaticResource Visible}}">
      <TextBlock Style="{StaticResource Label}" Text="Min:" />
      <StackPanel>
        <TextBox Text="{Binding MinText, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource Error}" Text="{Binding FieldErrors[Min]}" />
      </StackPanel>
    </DockPanel>

    <DockPanel Style="{StaticResource Field}" Visibility="{Binding ShowLimits, Converter={StaticResource Visible}}">
      <TextBlock Style="{StaticResource Label}" Text="Max:" />
      <StackPanel>
        <TextBox Text="{Binding MaxText, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource Error}" Text="{Binding FieldErrors[Max]}" />
      </StackPanel>
    </DockPanel>

    <DockPanel Style="{StaticResource Field}">
      <TextBlock Style="{StaticResource Label}" Text="Mô tả:" />
      <StackPanel>
        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource Error}" Text="{Binding FieldErrors[Description]}" />
      </StackPanel>
    </DockPanel>

    <TextBlock Text="{Binding Message}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="118,0,0,0" />

    <DockPanel Margin="0,14,0,0">
      <Button x:Name="CheckButton" Content="Kiểm tra" Padding="10,0" Click="OnCheck"
              ToolTip="Kiểm tra tag này trên Edge, không đổi cấu hình nháp" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Áp dụng" Width="80" IsDefault="True" Click="OnApply" />
        <Button Content="Đóng" Width="80" Margin="8,0,0,0" IsCancel="True" />
      </StackPanel>
    </DockPanel>
  </StackPanel>
</Window>
